{
  "name": "offerline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "dev:api": "tsx watch server/main.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && vite build && tsup server/main.ts server/cli.ts --format esm --out-dir dist/server --target node24 --clean",
    "start": "node dist/server/main.js",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^10.1.6",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "fastify": "^5.6.2",
    "imapflow": "^2.12.2",
    "mailparser": "^3.15.0",
    "mysql2": "^3.24.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^27.0.0",
    "playwright-core": "^1.56.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
